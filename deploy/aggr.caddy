# BEGIN aggr (managed by aggr/deploy/install.sh)
charts.oggregator.xyz {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# tradfi history server (aggr-server in docker, see aggr-server/tradfi)
	handle_path /history/* {
		reverse_proxy 127.0.0.1:3010
	}

	handle {
		reverse_proxy 127.0.0.1:8060
	}
}
# END aggr
